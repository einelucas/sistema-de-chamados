# Variáveis usadas pelo docker-compose.yml na raiz do projeto.
# Copie este arquivo para .env antes de rodar `docker compose up`.

# Ambiente de execucao do backend: development (padrao, usado por este .env de exemplo) ou
# production. Em production, o backend RECUSA iniciar se SECRET_KEY, ADMIN_PASSWORD ou
# DATABASE_URL ainda estiverem com os valores de exemplo abaixo, ou se CORS_ORIGINS for "*".
# So mude para production depois de substituir todos os valores de exemplo por segredos reais.
ENVIRONMENT=development

# Senha do banco PostgreSQL (troque por uma senha forte antes de ENVIRONMENT=production)
POSTGRES_PASSWORD=postgres

# Chave secreta do backend (gere uma chave forte em producao, ex.: `openssl rand -hex 32`)
SECRET_KEY=troque-esta-chave-por-uma-chave-secreta-forte

# Credenciais do administrador criado pelo seed (troque a senha antes de ENVIRONMENT=production)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=troque-esta-senha

# Origem permitida para CORS (URL do frontend). Nunca use "*" em producao.
CORS_ORIGINS=http://localhost:3000

# URL base da API usada pelo frontend
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

